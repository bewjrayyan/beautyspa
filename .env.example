#Application
# Production template: copy .env.production.example → .env on server
APP_ENV=local
APP_DEBUG=true
SHOW_DETAILED_ERRORS=false
APP_CACHE=true
APP_INSTALLED=false
APP_KEY=
APP_NAME=AestheticCart
# Include subdirectory when not at domain root, e.g. https://example.com/v2
APP_URL=http://localhost/fleetcart

#Catalog sync (Admin → Settings → System): same token on local + production
#CATALOG_SYNC_TOKEN=your-secret-token-here
#CATALOG_SYNC_SOURCE_URL=http://localhost/fleetcart/catalog-sync/bundle

#Security headers (see docs/SECURITY.md)
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
#SECURITY_CSP_REPORT_URI=
#SECURITY_ALLOW_INLINE_CUSTOM_SCRIPTS=false
#SECURITY_CUSTOM_SCRIPT_HOSTS=www.googletagmanager.com,www.google-analytics.com,www.google.com,www.gstatic.com
SECURITY_HSTS_ENABLED=true

#Privacy retention (dry-run command is always safe; execution requires explicit opt-in)
PRIVACY_RETENTION_ENABLED=false
#PRIVACY_COMPLETED_CONSULTATION_DAYS=2555
PRIVACY_EXPIRED_REQUEST_DAYS=90
PRIVACY_CONSULTATION_ACCESS_LOG_DAYS=730
PRIVACY_RETENTION_CHUNK_SIZE=100

#Ignition
IGNITION_EDITOR=vscode

#Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

#Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

#Queue
QUEUE_DRIVER=sync
#QUEUE_HEALTH_MONITOR_ENABLED=false
#QUEUE_HEALTH_MAX_PENDING=100
#QUEUE_HEALTH_MAX_FAILED=0
#QUEUE_HEALTH_MAX_PENDING_MINUTES=10

#Cache
CACHE_DRIVER=file
# CACHE_DRIVER=redis

#Performance / CDN (see docs/PERFORMANCE.md)
# ASSET_CDN_URL=
# MEDIA_CDN_URL=
# STOREFRONT_LAYOUT_CACHE_TTL=3600
# RESPONSE_CACHE_ENABLED=false
# RESPONSE_CACHE_HOME_ENABLED=false
# RESPONSE_CACHE_TTL_MINUTES=60
# SLOW_QUERY_LOG_ENABLED=false
# SLOW_QUERY_LOG_MS=500

# WhatsApp / OneSender (local: keep OFF to avoid accidental real sends during dev/tinker)
# ONESENDER_ALLOW_IN_LOCAL=false

#Session
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
# SESSION_ENCRYPT=true
# TRUSTED_PROXIES=127.0.0.1

#File System
FILESYSTEM_DRIVER=public_storage

#Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#Mail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAIL_ENCRYPTION=null

#Mailchimp
MAILCHIMP_APIKEY=

#AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

#Scout
SCOUT_QUEUE=false

#Laravel DataTables (yajra/laravel-datatables)
DATATABLES_ERROR=null

#Debugbar for Laravel (barryvdh/laravel-debugbar)
DEBUGBAR_ENABLED=false

#Laravel Query Detector (beyondcode/laravel-query-detector)
QUERY_DETECTOR_ENABLED=false

#Production scheduler (required for appointment reminders & follow-ups)
#Add to server crontab: * * * * * cd /path/to/fleetcart && php artisan schedule:run >> /dev/null 2>&1
#See docs/TREATMENT_RESERVATION.md for TreatmentReservation WhatsApp & cron setup.
